<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/cameraView"
        android:layout_width="350dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/lupa_de_la_verdad"
        android:layout_width="767dp"
        android:layout_height="1153dp"
        android:alpha="0.30"
        android:contentDescription="Lupa de la verdad"
        android:rotation="45"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/cameraView"
        app:layout_constraintEnd_toEndOf="@id/cameraView"
        app:layout_constraintStart_toStartOf="@id/cameraView"
        app:layout_constraintTop_toTopOf="@id/cameraView"
        app:srcCompat="@drawable/oot3d_lens_of_truth_model" />

</androidx.constraintlayout.widget.ConstraintLayout>
